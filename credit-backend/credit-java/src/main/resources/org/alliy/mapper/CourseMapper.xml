<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.alliy.mapper.CourseMapper">

    <!-- 🥇 【核心修正】：学生端选课查询 -->
    <!-- 使用 INNER JOIN 将课程表c与关联表sc连接，取出 sc.score 成绩字段 -->
    <select id="selectByStudentId" resultType="org.alliy.pojo.Course">
        SELECT
            c.*,
            sc.score
        FROM course c
                 INNER JOIN student_course sc ON c.id = sc.course_id
        WHERE sc.student_id = #{studentId}
    </select>


    <select id="selectByTeacherId" resultType="org.alliy.pojo.Course">
        SELECT * FROM course
        WHERE teacher_id = #{teacherId}
    </select>
</mapper>